# Board description for ia16-elf (compile-only, no simulator).

# Load generic config.
load_generic_config "unix"

# ia16 is a cross target — compile tests only, no execution.
set_board_info noargs 1
set_board_info gcc,no_abs 1

# 30 second timeout per test (compile-only doesn't need long).
set_board_info gcc,timeout 30
